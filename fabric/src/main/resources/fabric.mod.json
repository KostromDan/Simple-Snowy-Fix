{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "KostromDan",
    "Apollo"
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license}",
  "icon": "${mod_id}_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.kostromdan.mods.simple_snowy_fix.fabric.SimpleSnowyFixModFabric"
    ],
    "client": [
      "dev.kostromdan.mods.simple_snowy_fix.fabric.client.SimpleSnowyFixModFabricClient"
    ]
  },
  "mixins": [
    "simple_snowy_fix-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=25"
  }
}
